<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120">
  <!-- Dark circular badge -->
  <circle cx="60" cy="60" r="58" fill="#1a0f0a" stroke="#f59e0b" stroke-width="3"/>
  <!-- Gear/octagon decoration -->
  <polygon points="60,10 80,22 90,44 82,66 62,74 40,66 30,44 38,22" fill="none" stroke="#d97706" stroke-width="2" opacity="0.4"/>
  <!-- HF text -->
  <text x="60" y="72" text-anchor="middle" font-family="Georgia, serif" font-size="38" font-weight="bold" fill="#f59e0b">HF</text>
  <!-- Amber glow ring -->
  <circle cx="60" cy="60" r="52" fill="none" stroke="#f59e0b" stroke-width="1" opacity="0.3"/>
</svg>
