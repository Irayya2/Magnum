<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 80">
  <!-- NITTE logo placeholder -->
  <rect width="300" height="80" rx="4" fill="#1a237e" opacity="0.95"/>
  <!-- Shield icon -->
  <path d="M30 15 L50 15 L50 45 Q50 58 38 65 Q26 58 26 45 Z" fill="none" stroke="white" stroke-width="2.5"/>
  <text x="38" y="44" text-anchor="middle" font-family="Arial" font-size="18" font-weight="bold" fill="white">N</text>
  <!-- NITTE text -->
  <text x="160" y="36" text-anchor="middle" font-family="Arial" font-size="20" font-weight="bold" fill="white">NITTE</text>
  <text x="160" y="55" text-anchor="middle" font-family="Arial" font-size="10" fill="rgba(255,255,255,0.8)">(Deemed to be University)</text>
  <!-- Divider -->
  <line x1="68" y1="20" x2="68" y2="60" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
</svg>
