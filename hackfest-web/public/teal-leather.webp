<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 120">
  <!-- Leather base -->
  <defs>
    <filter id="noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/>
      <feColorMatrix type="saturate" values="0"/>
      <feBlend in="SourceGraphic" mode="multiply"/>
    </filter>
    <linearGradient id="leather" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a5c4a;stop-opacity:1"/>
      <stop offset="50%" style="stop-color:#0f4035;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#0a2e25;stop-opacity:1"/>
    </linearGradient>
  </defs>
  <rect width="400" height="120" fill="url(#leather)"/>
  <rect width="400" height="120" fill="url(#leather)" filter="url(#noise)" opacity="0.3"/>
  <!-- Subtle stitch lines -->
  <line x1="8" y1="0" x2="8" y2="120" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
  <line x1="392" y1="0" x2="392" y2="120" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
  <line x1="0" y1="10" x2="400" y2="10" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
  <line x1="0" y1="110" x2="400" y2="110" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
</svg>
